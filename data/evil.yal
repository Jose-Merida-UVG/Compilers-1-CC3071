(* Evil test file with all edge cases *)
(* Nested comment (* inside comment *) test *)
{
(* Comment in header *)
import "fmt"
import "strings"
// Go comment style should be preserved
/* Multi-line Go comment
   should also be preserved */
}

(* Multiple comments between sections *)
(* *)
(**)

let brace_open = '{'
let brace_close = '}'
let both_braces = ['{' '}']
let star_paren = ['*' ')' '(' ]
let comment_like = "(*"
let another = '*' ')' (* inline comment after definition *)
let empty_action = '{' '}'
let pipe = '|'
let equals = '='
let complex = ('{' | '}') ('*' | ')')* "(*" "rule" "let"

(* Comment before rule *)

rule scanner =
  '{' { return LBRACE } (* brace in pattern *)
| '}' { return RBRACE }
| '(' ')' { return PARENS }
| "(*" { return COMMENT_START }
| "*)" { return COMMENT_END }
| '|' { return PIPE }
| '=' { return EQUALS }
| "rule" { return RULE_KEYWORD }
| "let" { return LET_KEYWORD }
| ['{' '}' '(' ')' '*'] { return SPECIAL }
| '{' '}' '{' { return NESTED_BRACES }
| (* empty pattern test *) brace_open { return USE_DEF }
| pipe | equals { return OPERATOR }
| ['a'-'z']+ '{' { return ID_WITH_BRACE }
| "}" "{{" "}}}" { return WEIRD_BRACES }
| (* test *) eof (* another comment *) { return EOF }

{
(* Trailer with comment *)
func helper() {
    (* YALex comment in Go code? *)
    if true {
        return "{{{"
    }
}
}
