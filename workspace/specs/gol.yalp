/* gol.yalp - subset of Go.

   program -> package IDENT ; imports topdecls
   Blocks use braces { }. All statements end in ';'.

   Expr precedence (low to high):
     ||            OR,  left-assoc
     &&            AND, left-assoc
     == != < <= > >=  comparison, non-associative
     + -           additive,       left-assoc
     * / % & |     multiplicative + bitwise, left-assoc
     unary         ! - * & prefix
     postfix       f(args)  a[i]  a.b  (chainable)
     primary       literal, ident, (expr)

   YES: package/import, func with params and return type, var, const,
        := (short define), += -= *= /=, expr++ expr--,
        if/else/else-if, for expr { }, for { }, return,
        !x -x *x &x (unary), true/false/nil, INT/FLOAT/HEX
   NO:  strings, multiple imports, receiver methods,
        type/struct with body, multiple assignment,
        go/defer/select/switch
*/

%token INT FLOAT HEX
%token KWPACKAGE KWIMPORT KWFUNC KWVAR KWCONST KWTYPE KWSTRUCT
%token KWIF KWELSE KWFOR KWRETURN
%token KWTRUE KWFALSE KWNIL
%token IDENT
%token DEFINE ASSN PLEQ MIEQ TIEQ DIEQ INC DEC ARROW
%token EQ NEQ LEQ GEQ LT GT
%token AND OR NOT
%token AMP PIPE
%token PLUS MINUS TIMES DIV MOD
%token LBRACE RBRACE LPAREN RPAREN LBRACK RBRACK
%token SEMI COLON DOT COMMA

%%

program:                     /* mandatory structure: package, imports, top decls */
    package_clause SEMI imports topdecls
;

package_clause:              /* package main */
    KWPACKAGE IDENT
;

imports:                     /* zero or more imports, left-recursive */
    imports import_decl      /* import fmt; import os; - one per line */
  | /* empty */
;

import_decl:                 /* import IDENT ; - identifiers only, no strings */
    KWIMPORT IDENT SEMI
;

topdecls:                    /* zero or more top-level declarations */
    topdecls topdecl
  | /* empty */
;

topdecl:
    funcdecl
  | vardecl
  | constdecl
;

funcdecl:
    KWFUNC IDENT LPAREN params RPAREN block           /* func f(x int) { } */
  | KWFUNC IDENT LPAREN params RPAREN type block      /* func f(x int) int { } */
;

params:                      /* parameter list, may be empty */
    paramlist
  | /* empty */              /* func f() { } */
;

paramlist:                   /* one or more params separated by comma */
    param
  | paramlist COMMA param
;

param:                       /* name type - e.g. x int, p *Node */
    IDENT type
;

type:                        /* supported types */
    IDENT                    /* int, float64, MyType */
  | TIMES IDENT              /* *int - pointer */
  | LBRACK RBRACK IDENT      /* []int - slice */
;

vardecl:
    KWVAR IDENT type SEMI            /* var x int; */
  | KWVAR IDENT type ASSN expr SEMI  /* var x int = 5; */
  | KWVAR IDENT ASSN expr SEMI       /* var x = 5; - inferred type */
;

constdecl:
    KWCONST IDENT ASSN expr SEMI          /* const x = 5; */
  | KWCONST IDENT type ASSN expr SEMI     /* const x int = 5; */
;

block:                       /* { stmts } - body for func, if, for */
    LBRACE stmts RBRACE
;

stmts:                       /* zero or more statements inside a block */
    stmts stmt
  | /* empty */
;

stmt:
    vardecl                          /* var x int; inside a block */
  | IDENT DEFINE expr SEMI           /* x := expr; - short define */
  | IDENT ASSN expr SEMI             /* x = expr; */
  | IDENT PLEQ expr SEMI             /* x += expr; */
  | IDENT MIEQ expr SEMI             /* x -= expr; */
  | IDENT TIEQ expr SEMI             /* x *= expr; */
  | IDENT DIEQ expr SEMI             /* x /= expr; */
  | expr INC SEMI                    /* x++; - postfix on any expr */
  | expr DEC SEMI                    /* x--; */
  | expr SEMI                        /* f(x); - call as statement */
  | if_stmt
  | for_stmt
  | return_stmt
;

if_stmt:
    KWIF expr block                        /* if x > 0 { } */
  | KWIF expr block KWELSE block           /* if x > 0 { } else { } */
  | KWIF expr block KWELSE if_stmt         /* if ... else if ... else if ... */
;

for_stmt:
    KWFOR block                      /* for { } - infinite loop */
  | KWFOR expr block                 /* for n > 0 { } - with condition */
;

return_stmt:
    KWRETURN SEMI                    /* return; */
  | KWRETURN expr SEMI               /* return x; */
;

expr:
    orexpr
;

orexpr:                      /* ||, left-assoc */
    orexpr OR andexpr
  | andexpr
;

andexpr:                     /* &&, left-assoc */
    andexpr AND cmpexpr
  | cmpexpr
;

cmpexpr:                     /* comparison, non-associative */
    addexpr EQ  addexpr
  | addexpr NEQ addexpr
  | addexpr LT  addexpr
  | addexpr LEQ addexpr
  | addexpr GT  addexpr
  | addexpr GEQ addexpr
  | addexpr
;

addexpr:                     /* + -, left-assoc */
    addexpr PLUS  mulexpr
  | addexpr MINUS mulexpr
  | mulexpr
;

mulexpr:                     /* * / % & |, left-assoc */
    mulexpr TIMES unary
  | mulexpr DIV   unary
  | mulexpr MOD   unary
  | mulexpr AMP   unary      /* & bitwise */
  | mulexpr PIPE  unary      /* | bitwise */
  | unary
;

unary:                       /* prefix operators */
    NOT   unary              /* !x */
  | MINUS unary              /* -x */
  | TIMES unary              /* *x - dereference */
  | AMP   unary              /* &x - address-of */
  | postfix
;

postfix:                     /* chainable postfix operators */
    primary
  | postfix DOT IDENT        /* a.b - field access */
  | postfix LBRACK expr RBRACK  /* a[i] - indexing */
  | postfix LPAREN args RPAREN  /* f(x,y) - call; also postfix()(args) */
;

primary:
    INT
  | FLOAT
  | HEX                      /* 0xFF */
  | KWTRUE
  | KWFALSE
  | KWNIL
  | IDENT
  | LPAREN expr RPAREN
;

args:
    arglist
  | /* empty */
;

arglist:
    expr
  | arglist COMMA expr
;
