(* go-like lexer *)

let digit   = ['0'-'9']
let lower   = ['a'-'z']
let upper   = ['A'-'Z']
let hexdig  = ['0'-'9' 'a'-'f' 'A'-'F']
let alpha   = lower | upper | '_'
let alnum   = alpha | digit
let int     = digit+
let float   = digit+ '.' digit+
let hex     = '0' ('x' | 'X') hexdig+
let ident   = alpha alnum*
let badlit  = digit+ alpha alnum*
let define  = ":="
let pleq    = "+="
let mieq    = "-="
let tieq    = "*="
let dieq    = "/="
let inc     = "++"
let dec     = "--"
let eq      = "=="
let neq     = "!="
let leq     = "<="
let geq     = ">="
let and     = "&&"
let or      = "||"
let arrow   = "<-"
let ws      = [' ' '\t' '\n' '\r']

rule gettoken =
  ws+        {  }
| float      { return FLOAT }
| hex        { return HEX }
| badlit     { return BADLIT }
| int        { return INT }
| define     { return DEFINE }
| pleq       { return PLEQ }
| mieq       { return MIEQ }
| tieq       { return TIEQ }
| dieq       { return DIEQ }
| inc        { return INC }
| dec        { return DEC }
| eq         { return EQ }
| neq        { return NEQ }
| leq        { return LEQ }
| geq        { return GEQ }
| and        { return AND }
| or         { return OR }
| arrow      { return ARROW }
| '+'        { return PLUS }
| '-'        { return MINUS }
| '*'        { return TIMES }
| '/'        { return DIV }
| '%'        { return MOD }
| '='        { return ASSN }
| '<'        { return LT }
| '>'        { return GT }
| '!'        { return NOT }
| '&'        { return AMP }
| '|'        { return PIPE }
| '{'        { return LBRACE }
| '}'        { return RBRACE }
| '('        { return LPAREN }
| ')'        { return RPAREN }
| '['        { return LBRACK }
| ']'        { return RBRACK }
| ';'        { return SEMI }
| ':'        { return COLON }
| '.'        { return DOT }
| ','        { return COMMA }
| "package"  { return KWPACKAGE }
| "import"   { return KWIMPORT }
| "func"     { return KWFUNC }
| "var"      { return KWVAR }
| "const"    { return KWCONST }
| "type"     { return KWTYPE }
| "struct"   { return KWSTRUCT }
| "if"       { return KWIF }
| "else"     { return KWELSE }
| "for"      { return KWFOR }
| "return"   { return KWRETURN }
| "true"     { return KWTRUE }
| "false"    { return KWFALSE }
| "nil"      { return KWNIL }
| ident      { return IDENT }
