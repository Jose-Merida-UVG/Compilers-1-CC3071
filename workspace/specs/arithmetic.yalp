/* arithmetic.yalp - arithmetic expressions.

   Single expression per file, no statements, no semicolons.
   Start symbol: expr.

   Precedence (low to high):
     +  -          additive,       left-assoc
     *  /  %       multiplicative, left-assoc
     **            power,          right-assoc (right recursion in power)
     atom          base case

   YES: 2 + 3 * 4,  x ** 2,  pow(a,b),  f(1, 2+3),  (a+b)*c
   NO:  -x (no unary minus),  x == y,  true/false,  statements,  0xFF
*/

%token FLOAT INT
%token POW KWPOW
%token PLUS MINUS TIMES DIV MOD
%token LPAREN RPAREN COMMA
%token IDENT

%%

expr:                        /* root: + and -, left-assoc */
    expr PLUS term
  | expr MINUS term
  | term
;

term:                        /* * / %, left-assoc */
    term TIMES power
  | term DIV power
  | term MOD power
  | power
;

power:                       /* **, right-assoc: a**b**c = a**(b**c) */
    atom POW power
  | atom
;

atom:                        /* base: literal, ident, grouped expr, call */
    INT                      /* 42 */
  | FLOAT                    /* 3.14 */
  | IDENT                    /* x */
  | LPAREN expr RPAREN       /* (a + b) */
  | KWPOW LPAREN expr COMMA expr RPAREN  /* pow(base, exp) - built-in */
  | IDENT LPAREN args RPAREN /* f(a, b, c) - function call */
;

args:                        /* argument list, may be empty */
    arglist
  | /* empty */              /* f() */
;

arglist:                     /* one or more comma-separated exprs */
    expr
  | arglist COMMA expr
;
