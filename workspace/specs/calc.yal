(* Expression calculator with hex literals, comparison and logic ops *)
{
    const (
        FLOAT  = 1
        INT    = 2
        HEX    = 3
        PLUS   = 4
        MINUS  = 5
        TIMES  = 6
        DIV    = 7
        MOD    = 8
        POW    = 9
        PLEQ   = 10
        MIEQ   = 11
        TIEQ   = 12
        DIEQ   = 13
        ASSN   = 14
        EQ     = 15
        NEQ    = 16
        LT     = 17
        LEQ    = 18
        GT     = 19
        GEQ    = 20
        AND    = 21
        OR     = 22
        NOT    = 23
        LPAREN = 24
        RPAREN = 25
        COMMA  = 26
        KWLET  = 27
        KWIF   = 28
        KWELSE = 29
        IDENT  = 30
    )
}

let digit  = ['0'-'9']
let lower  = ['a'-'z']
let upper  = ['A'-'Z']
let alpha  = lower | upper | '_'
let hexdig = ['0'-'9' 'a'-'f' 'A'-'F']
let alnum  = alpha | digit
let int    = digit+
let float  = digit+ '.' digit+
let hex    = '0' ('x' | 'X') hexdig+
let ident  = alpha alnum*
let symbol = _ # ['a'-'z' 'A'-'Z' '0'-'9' '_' ' ' '\t' '\n' '\r']
let pow    = "**"
let pleq   = "+="
let mieq   = "-="
let tieq   = "*="
let dieq   = "/="
let eq     = "=="
let neq    = "!="
let leq    = "<="
let geq    = ">="
let and    = "&&"
let or     = "||"
let ws     = [' ' '\t' '\n' '\r']

rule gettoken =
  ws+    {  }
| float  { fmt.Print("FLOAT  "); return FLOAT }
| hex    { fmt.Print("HEX    "); return HEX }
| int    { fmt.Print("INT    "); return INT }
| pow    { fmt.Print("POW    "); return POW }
| pleq   { fmt.Print("PLEQ   "); return PLEQ }
| mieq   { fmt.Print("MIEQ   "); return MIEQ }
| tieq   { fmt.Print("TIEQ   "); return TIEQ }
| dieq   { fmt.Print("DIEQ   "); return DIEQ }
| eq     { fmt.Print("EQ     "); return EQ }
| neq    { fmt.Print("NEQ    "); return NEQ }
| leq    { fmt.Print("LEQ    "); return LEQ }
| geq    { fmt.Print("GEQ    "); return GEQ }
| and    { fmt.Print("AND    "); return AND }
| or     { fmt.Print("OR     "); return OR }
| '+'    { fmt.Print("PLUS   "); return PLUS }
| '-'    { fmt.Print("MINUS  "); return MINUS }
| '*'    { fmt.Print("TIMES  "); return TIMES }
| '/'    { fmt.Print("DIV    "); return DIV }
| '%'    { fmt.Print("MOD    "); return MOD }
| '='    { fmt.Print("ASSN   "); return ASSN }
| '<'    { fmt.Print("LT     "); return LT }
| '>'    { fmt.Print("GT     "); return GT }
| '!'    { fmt.Print("NOT    "); return NOT }
| '('    { fmt.Print("LPAREN "); return LPAREN }
| ')'    { fmt.Print("RPAREN "); return RPAREN }
| ','    { fmt.Print("COMMA  "); return COMMA }
| "let"  { fmt.Print("KWLET  "); return KWLET }
| "if"   { fmt.Print("KWIF   "); return KWIF }
| "else" { fmt.Print("KWELSE "); return KWELSE }
| ident  { fmt.Print("IDENT  "); return IDENT }
