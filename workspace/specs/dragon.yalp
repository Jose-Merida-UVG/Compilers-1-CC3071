/* Dragon Book §4.5 — classic unambiguous expression grammar.
   Good for verifying FIRST/FOLLOW since the answers are in the book.

   FIRST(e)  = { LPAREN, ID }
   FIRST(t)  = { LPAREN, ID }
   FIRST(f)  = { LPAREN, ID }
   FOLLOW(e) = { $, PLUS, RPAREN }
   FOLLOW(t) = { $, PLUS, TIMES, RPAREN }
   FOLLOW(f) = { $, PLUS, TIMES, RPAREN }
*/

%token ID
%token PLUS
%token TIMES
%token LPAREN RPAREN

%%

e:
    e PLUS t
  | t
;

t:
    t TIMES f
  | f
;

f:
    LPAREN e RPAREN
  | ID
;
