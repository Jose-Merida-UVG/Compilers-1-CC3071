(* Programming language token lexer *)
{
  (* Header *)
}

let digit    = ['0'-'9']
let lower    = ['a'-'z']
let upper    = ['A'-'Z']
let letter   = lower | upper
let alnum    = letter | digit
let ident    = letter (alnum | '_')*
let int      = digit+
let ws       = [' ' '\t' '\n' '\r']

rule gettoken =
  ws+                        { (* skip *) }
| "if"                       { return IF }
| "else"                     { return ELSE }
| "while"                    { return WHILE }
| "for"                      { return FOR }
| "return"                   { return RETURN }
| "let"                      { return LET }
| "true"                     { return TRUE }
| "false"                    { return FALSE }
| ident                      { return IDENT }
| int                        { return INT }
| "=="                       { return EQ }
| "!="                       { return NEQ }
| "<="                       { return LEQ }
| ">="                       { return GEQ }
| '<'                        { return LT }
| '>'                        { return GT }
| '='                        { return ASSIGN }
| '+'                        { return PLUS }
| '-'                        { return MINUS }
| '*'                        { return TIMES }
| '/'                        { return DIV }
| '{'                        { return LBRACE }
| '}'                        { return RBRACE }
| '('                        { return LPAREN }
| ')'                        { return RPAREN }
| ';'                        { return SEMI }
| ','                        { return COMMA }
| eof                        { raise EOF }
