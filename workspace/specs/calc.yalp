/* calc.yalp - simple imperative language.

   Statements end in ';'. Blocks ALWAYS use parens ( stmts ).
   No bare single-stmt shorthand - keeps grammar SLR(1) (no dangling-else).

   Expr precedence (low to high):
     ||            OR,  left-assoc
     &&            AND, left-assoc
     !             NOT, right-assoc prefix
     == != < <= > >=  comparison, non-associative
     + -           additive,       left-assoc
     * / %         multiplicative, left-assoc
     **            power,          right-assoc
     - (unary)     unary minus, prefix
     atom          base case

   YES: let x = expr;  x = expr;  x += expr (-= *= /=)
        if expr ( stmts )
        if expr ( stmts ) else ( stmts )
        while expr ( stmts )
        expr;  true/false  0xFF  3.14  -x  (expr)
   NO:  f(a,b) - no function calls (conflicts with block parens in SLR1)
        braces { },  for,  func,  strings,  x++ x--,  decl without value
*/

%token FLOAT INT HEX
%token KWTRUE KWFALSE
%token PLUS MINUS TIMES DIV MOD POW
%token EQ NEQ LT LEQ GT GEQ
%token AND OR NOT
%token LPAREN RPAREN SEMI
%token ASSN KWLET KWIF KWELSE WHILE
%token PLEQ MIEQ TIEQ DIEQ
%token IDENT

%%

program:                     /* a file is a sequence of statements */
    stmts
;

stmts:                       /* one or more stmts, left-recursive */
    stmts stmt
  | stmt
;

stmt:
    KWLET IDENT ASSN expr SEMI            /* let x = expr; */
  | IDENT ASSN expr SEMI                 /* x = expr; */
  | IDENT PLEQ expr SEMI                 /* x += expr; */
  | IDENT MIEQ expr SEMI                 /* x -= expr; */
  | IDENT TIEQ expr SEMI                 /* x *= expr; */
  | IDENT DIEQ expr SEMI                 /* x /= expr; */
  | KWIF expr stmtblock                  /* if expr ( stmts ) */
  | KWIF expr stmtblock KWELSE stmtblock /* if expr ( stmts ) else ( stmts ) */
  | WHILE expr stmtblock                 /* while expr ( stmts ) */
  | expr SEMI                            /* f(x); - expression as statement */
;

stmtblock:                   /* block body: ALWAYS ( stmts ) */
    LPAREN stmts RPAREN
;

expr:
    orexpr
;

orexpr:                      /* ||, left-assoc */
    orexpr OR andexpr
  | andexpr
;

andexpr:                     /* &&, left-assoc */
    andexpr AND notexpr
  | notexpr
;

notexpr:                     /* !, prefix, right-assoc */
    NOT notexpr
  | cmpexpr
;

cmpexpr:                     /* comparison, non-associative */
    addexpr EQ  addexpr      /* == */
  | addexpr NEQ addexpr      /* != */
  | addexpr LT  addexpr      /* < */
  | addexpr LEQ addexpr      /* <= */
  | addexpr GT  addexpr      /* > */
  | addexpr GEQ addexpr      /* >= */
  | addexpr
;

addexpr:                     /* + -, left-assoc */
    addexpr PLUS  mulexpr
  | addexpr MINUS mulexpr
  | mulexpr
;

mulexpr:                     /* * / %, left-assoc */
    mulexpr TIMES powexpr
  | mulexpr DIV   powexpr
  | mulexpr MOD   powexpr
  | powexpr
;

powexpr:                     /* **, right-assoc: a**b**c = a**(b**c) */
    unary POW powexpr
  | unary
;

unary:                       /* unary minus, prefix */
    MINUS unary
  | atom
;

atom:
    INT
  | FLOAT
  | HEX                      /* 0xFF */
  | KWTRUE
  | KWFALSE
  | IDENT
  | LPAREN expr RPAREN       /* (expr) - grouping only, NOT a block */
;
/* Note: no function call syntax - IDENT LPAREN args RPAREN would conflict
   with stmtblock -> LPAREN stmts RPAREN via FOLLOW(expr). */
