(* Arithmetic expression lexer *)
{
    const (
        FLOAT  = 1
        INT    = 2
        PLUS   = 3
        MINUS  = 4
        TIMES  = 5
        DIV    = 6
        MOD    = 7
        LPAREN = 8
        RPAREN = 9
    )
}

let digit = ['0'-'9']
let int   = digit+
let float = digit+ '.' digit+
let ws    = [' ' '\t' '\n' '\r']

rule gettoken =
  ws+   {  }
| float { fmt.Println("XD"); return FLOAT}
| int   { return INT }
| '+'   { return PLUS }
| '-'   { return MINUS }
| '*'   { return TIMES }
| '/'   { return DIV }
| '%'   { return MOD }
| '('   { return LPAREN }
| ')'   { return RPAREN }
