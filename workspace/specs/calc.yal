let digit  = ['0'-'9']
let lower  = ['a'-'z']
let upper  = ['A'-'Z']
let alpha  = lower | upper | '_'
let hexdig = ['0'-'9' 'a'-'f' 'A'-'F']
let alnum  = alpha | digit
let int    = digit+
let float  = digit+ '.' digit+
let hex    = '0' ('x' | 'X') hexdig+
let ident  = alpha alnum*
let pow    = "**"
let pleq   = "+="
let mieq   = "-="
let tieq   = "*="
let dieq   = "/="
let eq     = "=="
let neq    = "!="
let leq    = "<="
let geq    = ">="
let and    = "&&"
let or     = "||"
let ws     = [' ' '\t' '\n' '\r']
let while  = "while"
let true   = "true"
let false  = "false"

rule gettoken =
  ws+    {  }
| while  { return WHILE}
| true   { return KWTRUE}
| false  { return KWFALSE}
| float  { return FLOAT }
| hex    { return HEX }
| int    { return INT }
| pow    { return POW }
| pleq   { return PLEQ }
| mieq   { return MIEQ }
| tieq   { return TIEQ }
| dieq   { return DIEQ }
| eq     { return EQ }
| neq    { return NEQ }
| leq    { return LEQ }
| geq    { return GEQ }
| and    { return AND }
| or     { return OR }
| '+'    { return PLUS }
| '-'    { return MINUS }
| '*'    { return TIMES }
| '/'    { return DIV }
| '%'    { return MOD }
| '='    { return ASSN }
| '<'    { return LT }
| '>'    { return GT }
| '!'    { return NOT }
| '('    { return LPAREN }
| ')'    { return RPAREN }
| ';'    { return SEMI }
| "let"  { return KWLET }
| "if"   { return KWIF }
| "else" { return KWELSE }
| ident  { return IDENT }
