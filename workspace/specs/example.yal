(* Example lexer spec - demonstrates a variety of token patterns.
   Build this to see a multi-state DFA with many transitions. *)

let digit  = ['0'-'9']
let lower  = ['a'-'z']
let upper  = ['A'-'Z']
let letter = lower | upper
let alnum  = letter | digit
let ws     = [' ' '\t' '\n' '\r']

rule tokens =
  ws+                    { (* skip whitespace *) }
| digit+ '.' digit+      { return FLOAT }
| digit+                 { return INT }
| letter alnum*          { return IDENT }
| '+'                    { return PLUS }
| '-'                    { return MINUS }
| '*'                    { return STAR }
| '/'                    { return SLASH }
| '='                    { return EQ }
| '<'                    { return LT }
| '>'                    { return GT }
| '('                    { return LPAREN }
| ')'                    { return RPAREN }
| '{'                    { return LBRACE }
| '}'                    { return RBRACE }
| eof                    { raise EOF }
