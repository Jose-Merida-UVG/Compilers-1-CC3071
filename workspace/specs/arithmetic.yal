let digit = ['0'-'9']
let lower = ['a'-'z']
let upper = ['A'-'Z']
let alpha = lower | upper
let alnum = alpha | digit
let int   = digit+
let float = digit+ '.' digit+
let pow   = "**"
let kwpow = "pow"
let ws    = [' ' '\t' '\n' '\r']

rule gettoken =
  ws+          {  }
| float        { fmt.Print("FLOAT  "); return FLOAT }
| int          { fmt.Print("INT    "); return INT }
| pow          { fmt.Print("POW    "); return POW }
| kwpow        { fmt.Print("KWPOW  "); return KWPOW }
| '+'          { fmt.Print("PLUS   "); return PLUS }
| '-'          { fmt.Print("MINUS  "); return MINUS }
| '*'          { fmt.Print("TIMES  "); return TIMES }
| '/'          { fmt.Print("DIV    "); return DIV }
| '%'          { fmt.Print("MOD    "); return MOD }
| '('          { fmt.Print("LPAREN "); return LPAREN }
| ')'          { fmt.Print("RPAREN "); return RPAREN }
| ','          { fmt.Print("COMMA  "); return COMMA }
| alpha alnum* { fmt.Print("IDENT  "); return IDENT }