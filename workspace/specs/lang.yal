(* lang.yal large spec *)
(* Tests: keyword vs identifier via maximal munch, deeply nested lets,   *)
(*        all common operators, multi-char operators before single-char,  *)
(*        lower/upper split into separate lets then recombined            *)
{
    const (
        IF     = 1
        ELSE   = 2
        WHILE  = 3
        FOR    = 4
        RETURN = 5
        INT_T  = 6
        BOOL_T = 7
        TRUE   = 8
        FALSE  = 9
        IDENT  = 10
        LIT_I  = 11
        LIT_F  = 12
        PLUS   = 13
        MINUS  = 14
        TIMES  = 15
        DIV    = 16
        MOD    = 17
        ASSN   = 18
        EQ     = 19
        NEQ    = 20
        LT     = 21
        LEQ    = 22
        GT     = 23
        GEQ    = 24
        AND    = 25
        OR     = 26
        NOT    = 27
        LPAREN = 28
        RPAREN = 29
        LBRACE = 30
        RBRACE = 31
        SEMI   = 32
        COMMA  = 33
    )
}

let digit   = ['0'-'9']
let lower   = ['a'-'z']
let upper   = ['A'-'Z']
let alpha   = lower | upper | '_'
let alnum   = alpha | digit
let int     = digit+
let float   = digit+ '.' digit+
let ident   = alpha alnum*
let ws      = [' ' '\t' '\n' '\r']
let eq      = '=' '='
let neq     = '!' '='
let leq     = '<' '='
let geq     = '>' '='
let and     = '&' '&'
let or      = '|' '|'
let kwif     = 'i' 'f'
let kwelse   = 'e' 'l' 's' 'e'
let kwwhile  = 'w' 'h' 'i' 'l' 'e'
let kwfor    = 'f' 'o' 'r'
let kwreturn = 'r' 'e' 't' 'u' 'r' 'n'
let kwint    = 'i' 'n' 't'
let kwbool   = 'b' 'o' 'o' 'l'
let kwtrue   = 't' 'r' 'u' 'e'
let kwfalse  = 'f' 'a' 'l' 's' 'e'

rule tokenize =
  ws+       {  }
| kwif      { return IF }
| kwelse    { return ELSE }
| kwwhile   { return WHILE }
| kwfor     { return FOR }
| kwreturn  { return RETURN }
| kwint     { return INT_T }
| kwbool    { return BOOL_T }
| kwtrue    { return TRUE }
| kwfalse   { return FALSE }
| float     { return LIT_F }
| int       { return LIT_I }
| ident     { return IDENT }
| eq        { return EQ }
| neq       { return NEQ }
| leq       { return LEQ }
| geq       { return GEQ }
| and       { return AND }
| or        { return OR }
| '='       { return ASSN }
| '<'       { return LT }
| '>'       { return GT }
| '!'       { return NOT }
| '+'       { return PLUS }
| '-'       { return MINUS }
| '*'       { return TIMES }
| '/'       { return DIV }
| '%'       { return MOD }
| '('       { return LPAREN }
| ')'       { return RPAREN }
| '{'       { return LBRACE }
| '}'       { return RBRACE }
| ';'       { return SEMI }
| ','       { return COMMA }
