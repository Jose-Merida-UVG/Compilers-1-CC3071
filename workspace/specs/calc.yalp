/* calc.yalp — imperative language with type-safe grammar.

   TYPE ENFORCEMENT AT PARSE TIME:
   - numexpr: numeric expressions (INT, FLOAT, HEX, arithmetic)
   - boolexpr: boolean expressions (TRUE, FALSE, logic, comparisons)

   The grammar enforces:
   - Arithmetic operators (+, -, *, /, %, **) only work on numbers
   - Logical operators (&&, ||, !) only work on booleans
   - Comparisons (<, >, <=, >=) take numbers, produce booleans
   - Control flow (if, while) requires boolean conditions

   Limitation: Variables (IDENT) can appear in both contexts since we
   don't track types at parse time. Runtime would still need to check
   that number variables aren't used in boolean context and vice versa.
*/

%token FLOAT INT HEX
%token KWTRUE KWFALSE
%token PLUS MINUS TIMES DIV MOD POW
%token EQ NEQ LT LEQ GT GEQ
%token AND OR NOT
%token LPAREN RPAREN COMMA SEMI
%token ASSN KWLET KWIF KWELSE WHILE
%token PLEQ MIEQ TIEQ DIEQ
%token IDENT

%%

program:
    stmts
;

stmts:
    stmts stmt
  | stmt
;

stmt:
    KWLET IDENT ASSN numexpr SEMI
  | KWLET IDENT ASSN boolexpr SEMI
  | IDENT ASSN numexpr SEMI
  | IDENT ASSN boolexpr SEMI
  | IDENT PLEQ numexpr SEMI
  | IDENT MIEQ numexpr SEMI
  | IDENT TIEQ numexpr SEMI
  | IDENT DIEQ numexpr SEMI
  | KWIF boolexpr stmtblock
  | KWIF boolexpr stmtblock KWELSE stmtblock
  | WHILE boolexpr stmtblock
  | numexpr SEMI
  | boolexpr SEMI
;

stmtblock:
    stmt
  | LPAREN stmts RPAREN
;

/* ── Numeric Expressions ────────────────────────────────────────── */

numexpr:
    numexpr PLUS numterm
  | numexpr MINUS numterm
  | numterm
;

numterm:
    numterm TIMES numfactor
  | numterm DIV numfactor
  | numterm MOD numfactor
  | numfactor
;

numfactor:
    numprimary POW numfactor
  | numprimary
;

numprimary:
    INT
  | FLOAT
  | HEX
  | IDENT
  | MINUS numprimary
  | LPAREN numexpr RPAREN
  | IDENT LPAREN numargs RPAREN
;

numargs:
    numarglist
  | /* empty */
;

numarglist:
    numexpr
  | numarglist COMMA numexpr
;

/* ── Boolean Expressions ────────────────────────────────────────── */

boolexpr:
    boolexpr OR boolterm
  | boolterm
;

boolterm:
    boolterm AND boolfactor
  | boolfactor
;

boolfactor:
    NOT boolfactor
  | boolprimary
;

boolprimary:
    KWTRUE
  | KWFALSE
  | IDENT
  | numexpr EQ numexpr
  | numexpr NEQ numexpr
  | numexpr LT numexpr
  | numexpr LEQ numexpr
  | numexpr GT numexpr
  | numexpr GEQ numexpr
  | LPAREN boolexpr RPAREN
;
