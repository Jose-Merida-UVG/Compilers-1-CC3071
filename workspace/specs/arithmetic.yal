let digit = ['0'-'9']
let lower = ['a'-'z']
let upper = ['A'-'Z']
let alpha = lower | upper
let alnum = alpha | digit
let int   = digit+
let float = digit+ '.' digit+
let pow   = "**"
let kwpow = "pow"
let ws    = [' ' '\t' '\n' '\r']

rule gettoken =
  ws+          {  }
| float        { return FLOAT }
| int          { return INT }
| pow          { return POW }
| kwpow        { return KWPOW }
| '+'          { return PLUS }
| '-'          { return MINUS }
| '*'          { return TIMES }
| '/'          { return DIV }
| '%'          { return MOD }
| '('          { return LPAREN }
| ')'          { return RPAREN }
| ','          { return COMMA }
| alpha alnum* { return IDENT }
