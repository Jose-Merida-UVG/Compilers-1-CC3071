/* arithmetic.yalp — expressiones aritméticas con precedencia completa.
   Usa los tokens de arithmetic.yal.

   Precedencia (menor a mayor):
     + -        (additive)
     * / %      (multiplicative)
     **         (power, right-assoc via right recursion)
     atom       (literal, ident, llamada a función, kwpow, paréntesis)

   FIRST/FOLLOW relevantes:
     FIRST(expr)  = { INT, FLOAT, IDENT, LPAREN, KWPOW }
     FOLLOW(expr) = { $, RPAREN, COMMA }
*/

%token FLOAT INT
%token POW KWPOW
%token PLUS MINUS TIMES DIV MOD
%token LPAREN RPAREN COMMA
%token IDENT

%%

expr:
    expr PLUS term
  | expr MINUS term
  | term
;

term:
    term TIMES power
  | term DIV power
  | term MOD power
  | power
;

power:
    atom POW power
  | atom
;

atom:
    INT
  | FLOAT
  | IDENT
  | LPAREN expr RPAREN
  | KWPOW LPAREN expr COMMA expr RPAREN
  | IDENT LPAREN args RPAREN
;

args:
    arglist
  | /* empty */
;

arglist:
    expr
  | arglist COMMA expr
;
