/* epsilon_test.yalp - grammar with multiple nullable productions.

   Tests correct nullable propagation through FIRST and FOLLOW computation.
   Original grammar (from textbook):
     S  -> a B D h
     B  -> c C
     C  -> b C | epsilon
     D  -> E F
     E  -> g | epsilon
     F  -> f | epsilon

   Expected FIRST sets:
     s     = { A }
     bprod = { C }
     cprod = { B, epsilon }
     dprod = { G, F, epsilon }
     eprod = { G, epsilon }
     fprod = { F, epsilon }

   Expected FOLLOW sets:
     s     = { $ }
     bprod = { G, F, H }
     cprod = { G, F, H }
     dprod = { H }
     eprod = { F, H }
     fprod = { H }
*/

%token A
%token B
%token C
%token F
%token G
%token H

%%

s:                           /* S -> a B D h */
    A bprod dprod H
;

bprod:                       /* B -> c C */
    C cprod
;

cprod:                       /* C -> b C | epsilon */
    B cprod
  | /* empty */
;

dprod:                       /* D -> E F */
    eprod fprod
;

eprod:                       /* E -> g | epsilon */
    G
  | /* empty */
;

fprod:                       /* F -> f | epsilon */
    F
  | /* empty */
;
