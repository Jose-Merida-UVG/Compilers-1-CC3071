import tokens
import sys
}

(* Let definitions for common patterns *)
let digit = ['0'-'9']
let letter = ['a'-'z' 'A'-'Z']
let identifier = letter (letter | digit | '_')*
let whitespace = [' ' '\t' '\r']

rule lexer =
  whitespace+ { return lexbuf }
| '\n' { return NEWLINE }
| digit+ { return NUMBER }
| identifier { return ID }
| '+' { return PLUS }
| '-' { return MINUS }
| '=' { return EQUALS }
| "A{}{{}{{{{}}}}}" { return ONE }
| eof { return EOF }

