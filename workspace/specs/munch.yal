(* munch.yal medium spec *)
(* Tests: maximal munch on multi-char operators, float vs int,  *)
(*        multi-level let expansion for operator patterns       *)
{
    const (
        LT    = 1
        LEQ   = 2
        GT    = 3
        GEQ   = 4
        EQ    = 5
        NEQ   = 6
        ASSN  = 7
        PLUS  = 8
        INC   = 9
        MINUS = 10
        DEC   = 11
        ARROW = 12
        TIMES = 13
        DIV   = 14
        INT   = 15
        FLOAT = 16
    )
}

let digit = ['0'-'9']
let int   = digit+
let float = digit+ '.' digit+
let leq   = '<' '='
let geq   = '>' '='
let eq    = '=' '='
let neq   = '!' '='
let inc   = '+' '+'
let dec   = '-' '-'
let arrow = '-' '>'
let ws    = [' ' '\t' '\n' '\r']

rule scan =
  ws+   {  }
| leq   { return LEQ }
| geq   { return GEQ }
| eq    { return EQ }
| neq   { return NEQ }
| inc   { return INC }
| dec   { return DEC }
| arrow { return ARROW }
| '<'   { return LT }
| '>'   { return GT }
| '='   { return ASSN }
| '+'   { return PLUS }
| '-'   { return MINUS }
| '*'   { return TIMES }
| '/'   { return DIV }
| float { return FLOAT }
| int   { return INT }
